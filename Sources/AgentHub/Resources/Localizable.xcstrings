    "health.commandExists.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Executable found: %@. This is a safe static availability check, not a full MCP JSON-RPC handshake."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已找到可执行文件：%@。当前检查是安全的静态可用性检查，不等同于完整 MCP JSON-RPC 握手。"
          }
        }
      }
    },
    "health.commandExists.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command exists"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令存在"
          }
        }
      }
    },
    "health.commandUnavailable.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not found in PATH or absolute path: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有在 PATH 或绝对路径中找到：%@"
          }
        }
      }
    },
    "health.commandUnavailable.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令不可用"
          }
        }
      }
    },
    "health.missingCommand.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No command was parsed from the config, so MCP startup cannot be evaluated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置中没有解析到 command，无法判断 MCP 是否可启动。"
          }
        }
      }
    },
    "health.missingCommand.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing command"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少 command"
          }
        }
      }
    },
    "health.remoteMCP.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote URL detected. This version does not make network requests; it only confirms this is a remote endpoint: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到远程 URL。当前版本不主动发起网络请求，只确认这是一个远程端点：%@"
          }
        }
      }
    },
    "health.remoteMCP.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote MCP URL"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程 MCP 地址"
          }
        }
      }
    },
    "health.riskyArgs.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arguments include shell / sudo / rm -rf / curl-like fragments. Executable exists: %@. Review arguments manually before running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令存在 shell / sudo / rm -rf / curl 等片段。已确认可执行文件存在：%@，但建议人工检查参数后再运行。"
          }
        }
      }
    },
    "health.riskyArgs.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Risky command fragment"
          }
