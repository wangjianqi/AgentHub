    "risk.duplicateMCP.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same MCP server name appears in multiple config sources: %@. Confirm whether this is intentional to avoid different tools loading different parameters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同名 MCP server 出现在多个配置来源：%@。建议确认是否为有意复用，避免不同工具读取到不同参数。"
          }
