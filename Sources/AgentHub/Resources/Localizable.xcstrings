    "risk.hookPipeScript.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks execute automatically on events and are higher risk than ordinary config. Review manually and pin script sources."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hook 会在特定事件中自动执行，风险高于普通配置。建议人工审查并固定脚本来源。"
          }
        }
      }
    },
