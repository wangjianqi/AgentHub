    "dashboard.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version 2 supports MCP enable/disable, config backup, Diff, static availability checks, migration, and Profile grouping. Every write operation creates a backup first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第二版已支持启用/停用 MCP、配置备份、Diff、静态可用性检查、迁移和 Profile 分组。所有写入操作都会先备份。"
          }
        }
      }
    },
    "dashboard.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dashboard"
          }
        },
