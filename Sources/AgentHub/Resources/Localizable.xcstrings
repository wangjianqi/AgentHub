{
  "sourceLanguage": "en",
  "strings": {
    "agents.empty.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Currently scans Claude Code ~/.claude/agents and project .claude/agents, plus configured platform agent directories."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前主要扫描 Claude Code 的 ~/.claude/agents 和项目 .claude/agents，以及已配置平台的 agents 目录。"
          }
        }
      }
    },
    "agents.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Agents Found"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有发现 Agents"
          }
        }
      }
    },
    "agents.section.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d total."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %d 个。"
          }
        }
      }
    },
    "backups.backupFile": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份：%@"
          }
        }
      }
    },
    "backups.empty.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabling/enabling MCP or migrating MCP will automatically create backups."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停用/启用 MCP 或迁移 MCP 后会自动生成备份。"
          }
        }
      }
    },
    "backups.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Backups Yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无备份"
