    "risk.hookRiskyCommand.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hook appears to include destructive or privileged commands. Disable it first and confirm the purpose."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hook 中存在疑似破坏性或高权限命令。建议先禁用并确认用途。"
