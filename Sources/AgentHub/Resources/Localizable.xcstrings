    "backups.select.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a backup on the left to show the diff between the backup and the current file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左侧选择备份后，这里会显示备份文件和当前文件的差异。"
          }
        }
      }
    },
    "backups.select.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
