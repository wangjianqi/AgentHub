    "edit.mcpMigratedMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has been written to %@ user-level config. Environment variables keep only key names; fill in real values manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将 %@ 写入 %@ 的用户级配置。环境变量仅保留 key 名称，真实值需要你手动补齐。"
          }
        }
      }
    },
    "edit.mcpWritten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has been written to %@. A backup was created before the change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已写入 %@。修改前已备份。"
          }
        }
      }
    },
