    "risk.mcpPipeScript.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This MCP config appears to download via curl and pipe directly to shell. Prefer pinned versions, trusted sources, and manual script review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该 MCP 配置中疑似存在 curl 下载后直接交给 shell 执行的命令。建议改为固定版本、固定来源并人工审查脚本。"
          }
        }
      }
    },
